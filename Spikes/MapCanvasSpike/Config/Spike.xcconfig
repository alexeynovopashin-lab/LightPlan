// Песочница итерации 4 живёт отдельно от приложения: свой проект, свой bundle
// id, свои настройки. Пакеты из Packages/ она не тянет и зелёную сборку
// приложения сломать не может. Единственное отличие от TimebarSpike — внешняя
// зависимость MapLibre, ради которой песочница и заведена.

PRODUCT_NAME = MapCanvasSpike
PRODUCT_BUNDLE_IDENTIFIER = Novopashin.LightPlan.map
DEVELOPMENT_TEAM = 4A3PUKS9R9
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

SWIFT_VERSION = 6.0
// MapLibre — Objective-C библиотека без аннотаций Sendable: строгая
// конкурентность на ней не собирается. Прибор и модель всё равно на главном
// акторе, проверять тут нечего.
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
ENABLE_TESTABILITY = YES
ONLY_ACTIVE_ARCH = YES
ALWAYS_SEARCH_USER_PATHS = NO

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Map Canvas
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
