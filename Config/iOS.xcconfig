// Таргет LightPlan-iOS.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Info.plist собирается из этих ключей. Только портрет (docs/17 § 19): веб этого
// не умеет и показывает плашку, натив запрещает поворот сам.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
// Схема `lightplan://` (ответ клиента) — типы URL в ключах не задаются, они в файле, что Xcode сливает с этими ключами.
INFOPLIST_FILE = Config/Info-iOS.plist
// Геолокация — только по запросу пользователя («Найти меня»), одна точка, без фона.
// Текст видят на системном запросе; локализует его итерация 14.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Light Plan finds out where you are to work out light and weather for your place. Your coordinates go to Open-Meteo for the forecast or, where it is unreachable, to our server in Yandex Cloud; Apple looks up the place name. Exact coordinates are not sent anywhere else.
// Камера — слой AR (шаг 29.8в): дуга солнца поверх живого кадра. Спрашивается при первом входе в AR и только если
// камера есть. Кадры нигде не сохраняются и никуда не уходят (превью без выхода кадров и без записи).
INFOPLIST_KEY_NSCameraUsageDescription = Light Plan uses the camera to show where the sun will be: it draws the sun’s arc over the live view. Frames are not saved and are not sent anywhere.
// Календарь — зеркало съёмок в свой календарь «Light Plan» (шаг 30.1–3, docs/14). Спрашивается, когда человек включает
// «Съёмки в Календаре». Полный доступ, не «только запись»: под записью нельзя завести календарь и нельзя найти своё
// событие, чтобы сдвинуть или убрать (замер iOS 26.5, Tools/calendar_probe). Читаем и правим только свой календарь.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Light Plan shows your shoots in its own calendar called “Light Plan” and keeps it up to date when you change something. For that it needs access to Calendar: it reads and changes only its own calendar, never touches other events, and sends nothing anywhere.

// Значок (Алексей 24.10: «пусть на значке будет бирка как на web версии… тут пусть будет альфа»). Чистый AppIcon — только
// у основного «Light Plan» (Novopashin.LightPlan, ставится из main); любой другой идентификатор (слоты slotA…D, старые wt…)
// получает AppIconAlpha — тот же значок с латунной «α» (Tools/app_icon_alpha.py). Выбор по идентификатору, не по ветке:
// phone.sh задаёт его в командной строке, и обойти выбор, не сменив идентификатор, нельзя. Сторожит Tools/check_app_icon.sh.
LP_APPICON_Novopashin_LightPlan = AppIcon
LP_APPICON = $(LP_APPICON_$(PRODUCT_BUNDLE_IDENTIFIER:identifier))
ASSETCATALOG_COMPILER_APPICON_NAME = $(LP_APPICON:default=AppIconAlpha)
