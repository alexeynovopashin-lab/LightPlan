<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Своя схема: ответ клиента приходит адресом lightplan://…?ans=<код> (итерация 28, шаг 9). Остальные ключи Info.plist собирает Xcode из INFOPLIST_KEY_* (Config/iOS.xcconfig). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Light Plan</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lightplan</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
