// Общее для обоих таргетов и обеих конфигураций. Все настройки живут в .xcconfig,
// а не в LightPlan.xcodeproj: разъезд между таргетами исключён по построению.
// Слои: Shared ← Debug/Release (проект) и iOS/macOS (таргет).

PRODUCT_NAME = LightPlan
// Постоянный адрес приложения в системах Apple (docs/17 § 19). Одинаков на iOS и macOS.
// LP_APP_ID — один адрес на всю сборку: приложение, виджет ($(LP_APP_ID).Widget, Config/Widget.xcconfig) и общая папка
// (group.$(LP_APP_ID)). phone.sh подменяет только его (слоты): PRODUCT_BUNDLE_IDENTIFIER в командной строке лёг бы
// на все таргеты разом и дал бы виджету адрес приложения (docs/30b_widget_cut.md).
LP_APP_ID = Novopashin.LightPlan
PRODUCT_BUNDLE_IDENTIFIER = $(LP_APP_ID)
DEVELOPMENT_TEAM = 4A3PUKS9R9
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// Swift 6, строгая конкурентность (docs/17 § 1).
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

ALWAYS_SEARCH_USER_PATHS = NO

GENERATE_INFOPLIST_FILE = YES
// Имя на главном экране; слоты phone.sh зовёт «LP <ветка>» через LP_APP_NAME (виджет носит то же имя).
LP_APP_NAME = Light Plan
INFOPLIST_KEY_CFBundleDisplayName = $(LP_APP_NAME)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Фаза «Check module boundaries» читает Packages/ и Tools/ за пределами своих входов.
ENABLE_USER_SCRIPT_SANDBOXING = NO
