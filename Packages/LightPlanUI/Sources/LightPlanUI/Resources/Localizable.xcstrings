    "tour.cal.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месяц, неделя или один день. Жанр стоит прямо в клетке словом, а не значком."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Month, week or a single day. The genre sits in the cell as a word, not as a dot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes, semana o un solo día. El género va en la celda con palabras, no con un punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月・週・日で表示。ジャンルは点ではなく言葉でセルに入ります。"
          }
        },
        "zh" : {
          "stringUnit" : {
