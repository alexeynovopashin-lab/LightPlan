    "tel.mineD" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съёмки, контакты и документы останутся на месте. Прежний ID продолжит работать: кто записал вас по нему, тот по нему и найдёт."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoots, contacts and documents stay where they are. The old ID keeps working: whoever saved you under it will still find you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones, los contactos y los documentos se quedan donde están. El ID anterior sigue funcionando: quien te guardó con él te seguirá encontrando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影・連絡先・書類はそのままです。以前のIDも使えます。そのIDで登録した人は引き続きあなたを見つけられます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄、联系人和文档都保持原样。以前的 ID 继续有效：按它保存你的人照样能找到你。"
          }
        }
      }
    },
