    "set.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съёмки, места и настройки хранятся на устройстве. На наш сервер не уходит ничего — его нет."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoots, spots and settings are kept on your device. Nothing goes to our server — there is none."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones, los lugares y los ajustes se guardan en tu dispositivo. A nuestro servidor no va nada — no existe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影・スポット・設定はお使いの端末に保存されます。当社のサーバーには何も送られません。そもそもサーバーがありません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄、地点和设置保存在您的设备上。没有任何数据发送到我们的服务器——因为不存在。"
          }
        }
      }
    },
