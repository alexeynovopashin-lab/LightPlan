    "tour.time.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ползунок двигает время: купол, телеметрия и погода пересчитываются на выбранную минуту. Один и тот же ползунок на «Свете» и «Карте»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The slider moves time: dome, telemetry and weather all recalculate for that minute. The same slider serves Light and Map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El deslizador mueve el tiempo: la cúpula, la telemetría y el clima se recalculan para ese minuto. Es el mismo deslizador en «Luz» y en «Mapa»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライダーで時間を動かすと、ドーム・計測値・天気がその時刻で再計算されます。光と地図で同じスライダーを使います。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑块调整时间：光穹顶、遥测和天气按所选分钟重新计算。在“光线”和“地图”中使用同一滑块。"
          }
        }
      }
    },
