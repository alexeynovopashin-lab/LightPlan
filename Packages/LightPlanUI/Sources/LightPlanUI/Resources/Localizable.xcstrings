      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тёплый графит: уже окно прибора, но ещё не провал в панели. Меняется только светлая тема."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm graphite: an instrument window, but not a hole in the panel. Light theme only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafito cálido: ya es la ventana de un instrumento, pero todavía no un hueco en el panel. Solo cambia el tema claro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温かみのあるグラファイト。計器の窓ですが、パネルの穴ではありません。変わるのはライトテーマのみです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖色石墨：已是仪器窗口，但尚未陷入面板。仅浅色主题可切换。"
          }
        }
      }
    },
    "set.drumNotePaper" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлая лента в бумажной панели — так сейчас. Меняется только светлая тема: в тёмной все три вида сходятся в один."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pale band in a paper panel — the current look. Light theme only: in the dark theme all three are the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una banda clara en un panel de papel — así está ahora. Solo cambia el tema claro: en el oscuro los tres modos se ven igual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紙のパネルに明るい帯。現在の見た目です。変わるのはライトテーマのみで、ダークテーマでは3つとも同じです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色纸面板中的亮色条带 — 即当前样式。仅浅色主题可切换：深色主题中三种样式合为一种。"
          }
        }
      }
    },
    "set.drumNoteWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тёмное окно, как шкала расстояний на объективе: у полости нет своего света, каким бы ни был корпус. Меняется только светлая тема."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dark window, like a lens distance scale: a cavity has no light of its own, whatever the body is made of. Light theme only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana oscura, como la escala de distancias de un objetivo: una cavidad no tiene luz propia, sea cual sea el cuerpo. Solo cambia el tema claro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レンズの距離目盛りのような暗い窓。本体が何であれ、くぼみは自ら光りません。変わるのはライトテーマのみです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗色窗口，如同镜头上的距离刻度：空腔本身无光，与机身无关。仅浅色主题可切换。"
          }
        }
      }
    },
