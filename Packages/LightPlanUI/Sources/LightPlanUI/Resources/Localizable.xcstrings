    "tour.sky.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тумблер меняет светило на куполе. У луны та же дуга, своя фаза и свои восход с заходом."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The switch changes the body on the dome. The moon gets the same arc, its own phase and its own rise and set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El interruptor cambia el astro en la cúpula. La luna tiene el mismo arco, su propia fase y su propia salida y puesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイッチでドームの天体を切り替えます。月にも同じ弧があり、固有の月齢と出入りがあります。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换开关改变穹顶上的天体。月亮有相同的弧线，并有自己的相位和升落时间。"
          }
        }
      }
    },
    "tour.sky.t" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солнце или луна"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun or moon"
          }
        },
        "es" : {
