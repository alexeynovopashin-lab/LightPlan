    "tour.add.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка заводит запись: дата, жанр, место, время начала. Дальше календарь и свет работают вместе."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This button starts a record: date, genre, place, start time. From there the calendar and the light work together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón crea un registro: fecha, género, lugar, hora de inicio. De ahí en adelante el calendario y la luz trabajan juntos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボタンで記録を始めます。日付、ジャンル、場所、開始時刻。そこからカレンダーと光が連携します。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按钮创建记录：日期、类型、地点、开始时间。之后日历和光线协同工作。"
          }
        }
      }
    },
