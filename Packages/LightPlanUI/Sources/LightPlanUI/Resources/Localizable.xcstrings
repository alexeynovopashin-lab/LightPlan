    "tel.copyD" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съёмки, контакты, организации и ссылки на документы уйдут в файл. Из него всё возвращается целиком."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoots, contacts, organisations and document links go into a file. Everything comes back from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones, los contactos, las organizaciones y los enlaces a documentos van a un archivo. Desde él se recupera todo entero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影・連絡先・組織・書類のリンクをファイルに保存します。そこからすべて戻せます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄、联系人、机构和文档链接都会存进一个文件。从它可以完整恢复。"
          }
        }
      }
    },
