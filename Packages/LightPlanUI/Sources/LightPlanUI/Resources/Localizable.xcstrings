    "start.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номер — ваш адрес снаружи: по нему организатор события свяжет ваши съёмки со своим планом. Можно оставить пустым и вписать позже."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your number is your address on the outside: by it an event organiser links your shoots to their plan. You can leave it empty and fill it in later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu número es tu dirección hacia fuera: por él un organizador enlaza tus sesiones con su plan. Puedes dejarlo vacío y escribirlo después."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番号は外部から見たあなたの宛先です。イベント主催者はこれで撮影を自分の計画に結びつけます。空欄のままにして後で入力することもできます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的号码就是对外的地址：活动组织者据此把您的拍摄接入他们的计划。可以先留空，之后再填。"
          }
        }
      }
    },
    "start.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Город, где вы живёте или сейчас находитесь, и номер телефона. Новые съёмки заводятся в этом городе, а поездку в другой приложение узнаёт само. Оба ответа меняются в настройках."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The city you live in or are staying in now, and your phone number. New shoots start in that city, and a trip to another one the app works out by itself. Both answers can be changed in settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ciudad donde vives o donde estás ahora, y tu número de teléfono. Las nuevas sesiones se crean en esa ciudad, y un viaje a otra la app lo deduce sola. Ambas respuestas se cambian en los ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住んでいる、または今滞在している都市と電話番号。新しい撮影はその都市から始まり、他の都市への移動はアプリが自動で判断します。どちらも設定で変更できます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您居住或当前所在的城市，以及您的电话号码。新拍摄默认在该城市，前往其他城市应用会自己判断。两项都可在设置中修改。"
          }
        }
      }
    },
    "start.telPh" : {
