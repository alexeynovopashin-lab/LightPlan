    "set.stepNote30" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время ставится получасами. Время, подсказанное светом, остаётся точным при любом шаге: золотой час не округляется."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time is set in half hours. The time suggested by the light stays exact at any step: the golden hour is not rounded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora se fija en medias horas. La hora que sugiere la luz sigue siendo exacta con cualquier paso: la hora dorada no se redondea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間は30分単位で設定します。光から提案される時刻はどの刻みでも正確で、ゴールデンアワーは丸められません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间以半小时为单位设置。光线建议的时间在任何步长下保持精确：黄金时刻不四舍五入。"
          }
        }
      }
    },
    "set.stepNoteN" : {
