    "set.delvNoteGenre" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок зависит от жанра: свадьба 3 месяца, репортаж 3 дня, архитектура 5 дней."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The term depends on the genre: wedding 3 months, reportage 3 days, architecture 5 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plazo depende del género: boda 3 meses, reportaje 3 días, arquitectura 5 días."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
