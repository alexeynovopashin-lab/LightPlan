      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш номер её не заменит: календарь не приезжает по номеру, он лежит здесь, на этом телефоне. Копию вы уже сохранили — отдайте её прежнему владельцу."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your number will not replace it: a calendar does not arrive by number, it sits here, on this phone. You already saved a copy — hand it to the previous owner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu número no lo sustituye: un calendario no llega por número, está aquí, en este teléfono. Ya guardaste una copia — entrégasela al dueño anterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの番号では置き換わりません。カレンダーは番号で届くのではなく、この端末にあります。コピーは保存済みなので、前の持ち主に渡してください。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的号码替代不了它：日历不会跟着号码过来，它就在这里，在这部手机上。你已经保存了副本——把它交给原来的主人。"
          }
        }
      }
    },
