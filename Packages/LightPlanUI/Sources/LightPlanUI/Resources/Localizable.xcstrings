    "org.delAsk" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За организацией числится {n}. Удалить всё равно? Съёмки останутся, но потеряют заказчика."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This company has {n} on file. Delete anyway? The shoots stay, but lose their customer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta empresa tiene {n} en su ficha. ¿Eliminar igual? Las sesiones quedan, pero pierden al contratante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この組織には{n}が登録されています。それでも削除しますか？撮影は残りますが、依頼主の情報は失われます。"
