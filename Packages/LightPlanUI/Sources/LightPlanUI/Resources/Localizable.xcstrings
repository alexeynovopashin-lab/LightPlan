            "value" : "太阳或月亮"
          }
        }
      }
    },
    "tour.stats.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календарь подводит итог за год: сколько снято и что впереди, по жанрам, со сроками сдачи и деньгами. Вводить отдельно ничего не нужно."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calendar sums the year up: what has been shot and what is ahead, by genre, with delivery dates and money. Nothing to enter twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario resume el año: cuánto se fotografió y qué viene, por género, con plazos de entrega y dinero. No hay que cargar nada aparte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーが1年をまとめます。撮影済みと予定をジャンル別に、納品日と金額つきで。二重入力は不要です。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日历自动汇总全年：已拍摄和待拍摄数量，按类型、交付期限和金额。无需单独输入。"
          }
        }
      }
    },
    "tour.stats.t" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Год считает сам"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The year counts itself"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El año se cuenta solo"
          }
        },
        "ja" : {
