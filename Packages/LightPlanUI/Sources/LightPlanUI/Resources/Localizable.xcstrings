      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия и файлы уходят в папку приложения на Dropbox. Остальной Dropbox приложению не виден."
          }
        },
        "en" : {
          "stringUnit" : {
