    "tour.tele.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия, закат, золотой час, свет, тени, небо, ветер. Строки меняются вместе со временем на ползунке."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions, sunset, golden hour, light, shadows, sky, wind. The rows follow the time on the slider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiciones, atardecer, hora dorada, luz, sombras, cielo, viento. Las filas cambian junto con la hora del deslizador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天候、日の入り、ゴールデンアワー、光、影、空、風。各行はスライダーの時刻に連動します。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件、日落、黄金时刻、光线、阴影、天空、风。这些行随滑块时间变化。"
          }
        }
      }
    },
    "tour.tele.t" : {
      "extractionState" : "manual",
      "localizations" : {
