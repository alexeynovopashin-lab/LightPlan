    "loc.studioTelNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочий номер студии, а не того, кто сегодня на смене: смены меняются, номер стойки — нет. По номеру студия и опознаётся — но завести её можно и без него."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The studio's own line, not whoever is on shift today: shifts change, the desk number doesn't. The number is what identifies the studio — but it can be added without one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número del propio estudio, no el de quien esté hoy de turno: los turnos cambian, el número del mostrador no. Por el número se identifica el estudio — pero se puede crear sin él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その日のスタッフではなく、スタジオ自体の番号を。スタッフは替わっても受付の番号は変わりません。スタジオは番号で識別されますが、番号なしでも登録できます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填影棚自己的号码，而不是今天当班的人：班次会换，前台号码不会。影棚正是靠号码识别——但没有号码也能创建。"
          }
        }
      }
    },
