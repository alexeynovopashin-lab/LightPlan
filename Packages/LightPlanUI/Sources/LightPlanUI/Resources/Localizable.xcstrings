    "set.themeNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняется интерфейс. Небо, свет и карта остаются прежними: закат не зависит от темы."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This changes the interface. Sky, light and map stay as they are: the sunset does not depend on the theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la interfaz. El cielo, la luz y el mapa quedan igual: el atardecer no depende del tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変わるのはインターフェースだけです。空・光・地図はそのまま。日の入りはテーマに左右されません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这改变界面。天空、光线和地图保持不变：日落不依赖于主题。"
          }
        }
      }
    },
