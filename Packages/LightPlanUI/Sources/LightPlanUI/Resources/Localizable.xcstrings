    "set.backupNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия — обычный файл. Положите его в Яндекс.Диск, iCloud или отправьте себе — из него всё восстановится."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup is an ordinary file. Put it in Yandex Disk or iCloud, or send it to yourself — everything restores from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia es un archivo común. Ponlo en Yandex Disk o iCloud, o envíatelo — de ahí se restaura todo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは普通のファイルです。Yandex Disk や iCloud に置くか、自分宛てに送ってください。そこからすべて復元できます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份是普通文件。将其放入Yandex Disk、iCloud或发送给自己——一切都会恢复。"
          }
        }
      }
    },
    "set.backupReady" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия готова. Сохраните её в Яндекс.Диск, iCloud или отправьте себе — из неё всё восстановится."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
