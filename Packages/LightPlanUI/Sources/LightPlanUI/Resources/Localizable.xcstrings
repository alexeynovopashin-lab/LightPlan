    "set.manualEndNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно съёмка завершается сама в записанное время конца. Включите, если снимаете дольше плана и хотите отмечать конец сами — в карточке появится кнопка «Завершить», а до нажатия она покажет, сколько идёт сверх плана."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shoot normally ends by itself at the recorded end time. Turn this on if you often run long and want to mark the end yourself — a «Finish» button appears on the card, and until you press it the card shows how far past the plan you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente la sesión termina sola a la hora de fin registrada. Actívalo si sueles alargarte y quieres marcar el final tú mismo: en la ficha aparece el botón «Terminar», y hasta pulsarlo verás cuánto llevas por encima del plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常、撮影は記録した終了時刻に自動で終わります。よく押す場合はオンにして自分で終了を記録しましょう。カードに「終了」ボタンが表示され、押すまで予定からの超過時間が表示されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄通常在记录的结束时间自动结束。如果你经常超时并希望自己标记结束，请开启——卡片上会出现「结束」按钮，按下之前会显示已超出计划多久。"
          }
        }
      }
    },
    "set.mode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
