    "tel.wipeAsk" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стереть всё на этом устройстве? Вернуть можно только из копии."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase everything on this device? Only a copy can bring it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Borrar todo en este dispositivo? Solo se puede recuperar desde una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のすべてを消去しますか？元に戻せるのはコピーだけです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除本设备上的所有内容？只能从备份恢复。"
          }
        }
      }
    },
    "tel.wipeD" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сотрёт всё на этом устройстве, включая подключение к облаку. Дальше — «Восстановить из копии», если она у вас есть."
          }
