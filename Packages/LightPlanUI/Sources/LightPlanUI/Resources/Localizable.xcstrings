    "set.notifyNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение говорит только о том, чего не увидеть самому: прогноз к съёмке переменился, съёмка стала конфликтной. Сервер пока не подключён — эта строка ждёт его."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app speaks up only about what you cannot see yourself: the forecast for a shoot has changed, a shoot has become a clash. There is no server yet — this row is waiting for one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación solo avisa de lo que no se puede ver por uno mismo: el pronóstico de la sesión ha cambiado, la sesión se ha vuelto conflictiva. Todavía no hay servidor: esta línea lo espera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが知らせるのは、自分では気づけないことだけです。撮影の予報が変わった、撮影が重なった、など。サーバーはまだないため、この項目は準備中です。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用只提醒你自己看不到的事：这场拍摄的预报变了，或它与别的安排撞上了。服务器尚未接入，这一项在等它。"
          }
        }
      }
    },
