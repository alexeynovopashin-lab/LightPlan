    "wc.moonDimM" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск освещён на {pct}%. Слабые детали Пути смоет; снимать можно, но лучше дождаться, когда луна сядет или пойдёт на убыль."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disc is {pct}% lit. Faint detail of the Way will wash out; you can still shoot, but it is better to wait for the moon to set or wane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco está iluminado al {pct}%. El detalle débil de la Vía se va a perder; se puede fotografiar igual, pero conviene esperar a que la luna se ponga o empiece a menguar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月は{pct}%輝いています。天の川の淡い部分は消えてしまいます。撮影は可能ですが、月が沈むか欠けていくのを待つのがおすすめです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月盘照亮{pct}%。银河的微弱细节会被冲淡；仍然可以拍摄，但最好等月亮落下或亏损。"
          }
        }
      }
    },
