    "tour.map.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карте видно, откуда светит солнце и куда ложится тень. Двигаете время — луч едет за ним."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map shows where the sun comes from and where the shadow falls. Move time and the ray follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el mapa se ve de dónde llega el sol y hacia dónde cae la sombra. Mueves el tiempo y el rayo lo sigue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図には太陽の方向と影の向きが表示されます。時間を動かすと光線も動きます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图上可见太阳从何方向照射以及阴影投向何处。调整时间 — 光束随之移动。"
          }
        }
      }
    },
    "tour.map.t" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компас света"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The light compass"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La brújula de la luz"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光のコンパス"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光罗盘"
          }
        }
      }
    },
    "tour.mode.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Просто» оставляет на экранах только нужное для съёмки. «Астро» добавляет азимуты, высоту солнца, длину тени, сумерки и ленту суток под ползунком."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple keeps only what a shoot needs. Astro adds azimuths, sun elevation, shadow length, twilight and the day ribbon under the slider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Simple» deja en las pantallas solo lo que hace falta para fotografiar. «Astro» agrega azimuts, altura del sol, longitud de la sombra, crepúsculo y la cinta del día bajo el deslizador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルは撮影に必要なものだけ。アストロは方位角、太陽高度、影の長さ、薄明、スライダー下の1日の帯を加えます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“简单”模式仅显示拍摄所需内容。“天文”模式添加方位角、太阳高度、影长、暮光以及滑块下方的日带。"
          }
        }
      }
    },
    "tour.mode.t" : {
