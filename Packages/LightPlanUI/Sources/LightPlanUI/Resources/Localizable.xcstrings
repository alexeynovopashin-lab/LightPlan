    "org.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "компания, агентство, площадка. Реквизиты и бумаги хранятся у неё, а не переписываются в каждую съёмку."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a company, an agency, a venue. Bank details and papers live with it, instead of being copied into every shoot."
