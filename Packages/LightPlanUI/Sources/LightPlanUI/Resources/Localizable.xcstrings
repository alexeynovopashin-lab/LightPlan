    "set.appIdNotMobile" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "нужен мобильный"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "needs a mobile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hace falta un móvil"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "携帯番号が必要です"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要手机号"
          }
        }
      }
    },
    "set.appIdNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельный код пришлось бы помнить и куда-то записывать. Номер телефона уже всемирный, уже уникальный и уже ваш — он и работает адресом: по нему организатор события свяжет ваши съёмки со своим планом. Годится мобильный: он ваш и переезжает вместе с вами, а городской остаётся в стене — со следующим арендатором студии."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate code would be one more thing to remember and write down. Your phone number is already worldwide, already unique and already yours — so it works as the address: an event organiser uses it to link your shoots to their plan. It has to be a mobile: that one is yours and moves with you, while a landline stays in the wall — with whoever rents the studio next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un código aparte sería una cosa más que recordar y apuntar en algún sitio. Tu número de teléfono ya es mundial, ya es único y ya es tuyo — por eso sirve de dirección: con él, el organizador de un evento vincula tus sesiones con su plan. Tiene que ser un móvil: ese es tuyo y se muda contigo, mientras que el fijo se queda en la pared — con quien alquile el estudio después."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のコードだと、覚えたりメモしたりする手間が増えます。電話番号はすでに世界共通で、唯一で、あなたのものです — だからそのまま宛先になります。イベントの主催者はこの番号であなたの撮影を自分の計画に結びつけます。使えるのは携帯番号です。携帯はあなたと一緒に移動しますが、固定電話は壁に残り、次にスタジオを借りる人のものになります。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独的代码又得记住、又得写在某处。你的电话号码本来就是全球通用、独一无二、属于你自己的——所以它直接充当地址：活动组织者用它把你的拍摄关联到自己的计划里。必须是手机号：手机号属于你，跟着你走，而座机留在墙上——归下一位租用影棚的人。"
          }
        }
      }
    },
    "set.appIdWas" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежние ID"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Former IDs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID anteriores"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のID"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前的 ID"
          }
        }
      }
    },
    "set.appIdWasNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старый ID не пропадает. Кто записал вас по нему раньше, тот по нему и найдёт: прежний ID считается тем же самым человеком, что и нынешний."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An old ID does not disappear. Anyone who noted you down by it will still reach you: a former ID counts as the same person as the current one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ID antiguo no desaparece. Quien te apuntó con él te seguirá encontrando: un ID anterior cuenta como la misma persona que el actual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いIDは消えません。以前そのIDで登録した人も、引き続きあなたにたどり着けます。以前のIDは現在のIDと同じ人物として扱われます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧 ID 不会消失。以前按它记下你的人，照样能找到你：以前的 ID 和现在的 ID 算同一个人。"
          }
        }
      }
    },
