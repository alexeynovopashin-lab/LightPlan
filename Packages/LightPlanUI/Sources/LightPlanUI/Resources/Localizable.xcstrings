    "cloud.noteOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия и файлы съёмок живут только на устройстве. Подключите облако — копия будет уходить туда сама, а документы и референсы станут доступны с других устройств."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup and shoot files live only on this device. Connect a cloud and the backup goes there by itself, while documents and references become available from your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia y los archivos de las sesiones viven solo en este dispositivo. Conecta una nube y la copia va sola hacia allá, y los documentos y las referencias quedan disponibles desde tus otros dispositivos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップと撮影のファイルはこの端末にのみあります。クラウドを接続すると、バックアップは自動でそこに送られ、書類や参考は他の端末からも使えます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份和拍摄文件仅存于本设备。连接云后备份会自动上传，文档和参考可从其他设备访问。"
          }
        }
      }
    },
