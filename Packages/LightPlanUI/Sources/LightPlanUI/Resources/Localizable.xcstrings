    "stats.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока не о чем рассказать — здесь появится занятость по месяцам, жанры и прибыль, как только в году будут съёмки."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to tell yet — months, genres and profit appear here as soon as the year has shoots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay nada que contar — aquí van a aparecer la carga por mes, los géneros y la ganancia en cuanto el año tenga sesiones."
          }
        },
        "ja" : {
          "stringUnit" : {
