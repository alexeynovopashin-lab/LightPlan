      }
    },
    "cloud.note.google" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия и файлы уходят в скрытую папку приложения на Google Диске. Остальной Диск приложению не виден. Доступ продлевается сам, пока вы не вышли из учётной записи Google."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup and files go to the app’s hidden folder on Google Drive. The rest of the Drive is invisible to the app. Access renews by itself while you stay signed in to Google."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia y los archivos van a la carpeta oculta de la app en Google Drive. El resto del Drive no es visible para la app. El acceso se renueva solo mientras sigas con la sesión iniciada en Google."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップとファイルは Google Drive のアプリ専用の隠しフォルダに保存されます。Drive のほかの部分はアプリから見えません。Google にログインしている間、アクセスは自動で更新されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份和文件进入Google Drive上应用的隐藏文件夹。其余Drive对应用不可见。访问会在您保持登录Google时自动续期。"
          }
        }
      }
    },
