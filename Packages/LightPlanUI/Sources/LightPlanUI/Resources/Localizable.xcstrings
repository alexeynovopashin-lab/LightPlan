        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップができました。Yandex Disk や iCloud に保存するか、自分宛てに送ってください。そこからすべて復元できます。"
          }
        },
        "zh" : {
