    "set.travelNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если между съёмками в разных местах остаётся меньше {n}, приложение предупредит. Запрета нет: решает фотограф."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If less than {n} is left between shoots in different places, the app will warn you. Nothing is forbidden: the photographer decides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si entre sesiones en lugares distintos queda menos de {n}, la aplicación avisa. No prohíbe nada: decide el fotógrafo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の場所での撮影の間隔が{n}未満になると、アプリが警告します。禁止はしません。決めるのはフォトグラファーです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不同地点拍摄之间剩余少于{n}，应用会警告。没有禁止：摄影师决定。"
          }
        }
      }
    },
