    "tour.place.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свет считается там, где вы снимаете. Место меняется тапом по шапке — геопозицией, поиском или координатами."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light is computed where you shoot. Tap the header to change the place — by location, by search or by coordinates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz se calcula donde fotografías. El lugar se cambia tocando el encabezado — por ubicación, por búsqueda o por coordenadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光は撮影場所で計算されます。見出しをタップして場所を変更。現在地、検索、座標で指定できます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光线按您拍摄的位置计算。点击顶部可更改地点 — 通过地理位置、搜索或坐标。"
          }
        }
      }
    },
