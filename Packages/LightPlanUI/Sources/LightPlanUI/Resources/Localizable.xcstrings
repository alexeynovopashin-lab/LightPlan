    "tour.cloud.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яндекс.Диск, Google или Dropbox: туда уходят копия данных и референсы съёмок. На наш сервер не уходит ничего."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk, Google or Dropbox: your data copy and shoot references go there. Nothing goes to our server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk, Google o Dropbox: ahí van la copia de los datos y las referencias de las sesiones. A nuestro servidor no va nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk、Google、Dropbox にデータのコピーと撮影の参考が保存されます。当社のサーバーには何も送られません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yandex Disk、Google 或 Dropbox：数据备份和拍摄参考资料存储于此。不会向我们的服务器发送任何内容。"
          }
        }
      }
    },
