    "loc.emptyMap" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точек пока нет. Закладка в шапке карты сохраняет место под булавкой — хоть на другом конце света — и просит его назвать."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No spots yet. The bookmark in the map header saves the place under the pin — anywhere in the world — and asks for its name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay puntos. El marcador en el encabezado del mapa guarda el lugar bajo el alfiler —en cualquier parte del mundo— y pide su nombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スポットはまだありません。地図上部のブックマークで、ピンの位置を保存できます — 世界の反対側でも — 保存時に名前を付けます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无地点。地图标题中的书签保存图钉所指的位置（世界任何角落都可以），并请您为它命名。"
          }
        }
      }
    },
