    "set.ribbonNoteDrum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сутки отдельными ячейками — знак вместо шкалы: фаза луны или облачность на несколько дней вперёд."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days as separate cells — a sign instead of a scale: moon phase or cloud cover several days ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días como celdas separadas — un signo en vez de una escala: fase de la luna o nubosidad para varios días adelante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日ごとに別のセル。目盛りの代わりに記号で、数日先の月齢や雲量を表示します。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期作为独立单元格——代替量表的标志：月相或未来几天的云量。"
          }
        }
      }
    },
