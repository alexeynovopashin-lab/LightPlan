    "set.modeNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Астро режим добавляет на экраны азимуты, высоту солнца, длину тени, сумерки и погодные данные — под спойлером «Подробно»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astro mode adds azimuths, sun elevation, shadow length, twilight and weather data to the screens — under the “Details” spoiler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Astro agrega a las pantallas azimuts, altura del sol, longitud de la sombra, crepúsculo y datos del clima — bajo el desplegable «En detalle»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天体モードでは、方位角、太陽高度、影の長さ、薄明、気象データが「詳細」の中に追加されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天文模式在屏幕上添加方位角、太阳高度、影长、暮光和天气数据——在“详情”折叠下。"
          }
        }
      }
    },
