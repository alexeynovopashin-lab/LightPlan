    "tour.hi.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свет, погода и съёмки — в одном месте. Покажу за минуту и прямо на живом экране. Выйти можно на любом шаге."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light, weather and shoots in one place. A minute on the live screen — you can leave at any step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz, clima y sesiones en un solo lugar. Te lo muestro en un minuto y sobre la pantalla real. Puedes salir en cualquier paso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光・天気・撮影をひとつに。実際の画面で1分ほど。どのステップでも抜けられます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光线、天气和拍摄 — 集中在一处。一分钟内直接在实时屏幕上展示。可在任何步骤退出。"
          }
        }
      }
    },
