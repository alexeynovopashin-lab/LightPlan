        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "una empresa, una agencia, un salón. Los datos bancarios y los papeles viven con ella, en vez de copiarse en cada sesión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会社、代理店、会場など。口座情報や書類は撮影ごとに書き写さず、組織側に保管されます。"
