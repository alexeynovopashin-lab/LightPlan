    "set.contactsNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все номера из съёмок и организаций одним списком. Номер, встреченный в двух карточках, — связка: заказчик, оказавшийся отцом невесты, виден только так."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every number from your shoots and companies in one list. A number found in two cards is a link: the client who turns out to be the bride’s father shows up no other way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los números de tus sesiones y organizaciones en una lista. Un número que aparece en dos fichas es un vínculo: el cliente que resulta ser el padre de la novia solo se ve así."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影と組織のすべての番号をひとつのリストに。2つのカードに出てくる番号は「つながり」です — 依頼主が実は新婦の父親だった、ということはこれでしか分かりません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄和机构中的所有号码汇成一个列表。在两张卡片里都出现的号码就是关联：原来是新娘父亲的客户，只有这样才能看出来。"
          }
        }
      }
    },
    "set.curNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Валюта по умолчанию для новой съёмки: {sample}. У каждой съёмки её можно поменять — в блоке «Оплата» формы. От языка не зависит: со сменой языка валюта остаётся прежней."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default currency for a new shoot: {sample}. Each shoot can override it — in the form’s “Payment” block. It does not follow the language: changing the language keeps the currency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moneda por defecto para una sesión nueva: {sample}. En cada sesión se puede cambiar — en el bloque «Pago» del formulario. No depende del idioma: al cambiar el idioma la moneda queda igual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい撮影の既定通貨：{sample}。撮影ごとにフォームの「支払い」で変更できます。言語とは連動せず、言語を変えても通貨は変わりません。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "费率、套餐和总计中的货币符号：{sample}。不跟随语言——切换语言时货币保持不变。"
          }
        }
      }
    },
