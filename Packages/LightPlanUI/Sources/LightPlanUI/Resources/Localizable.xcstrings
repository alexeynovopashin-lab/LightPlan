    "bin.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые съёмки лежат здесь, пока их не вернут или не сотрут насовсем. Клиент возвращается чаще, чем кажется."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted shoots stay here until they are restored or erased for good. Clients come back more often than you expect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones eliminadas quedan aquí hasta que las recuperes o las borres para siempre. Los clientes vuelven más seguido de lo que parece."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した撮影は、復元するか完全に消去するまでここに残ります。依頼主は思ったより戻ってくるものです。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的拍摄在此处保留，直到恢复或永久删除。客户比想象中更常回来。"
          }
        }
      }
    },
