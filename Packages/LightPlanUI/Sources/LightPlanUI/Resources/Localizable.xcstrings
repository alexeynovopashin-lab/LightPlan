    "set.musicNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плеер по умолчанию. Кнопка откроет его на съёмке, у которой нет своего плейлиста. Установлено приложение — откроется оно, нет — сайт."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default player. The button opens it on a shoot with no playlist of its own. If the app is installed it opens; if not, the website does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproductor por defecto. El botón lo abre en la sesión que no tenga su propia lista. Si la app está instalada, se abre ella; si no, el sitio web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定のプレーヤーです。プレイリストのない撮影では、ボタンでこれを開きます。アプリがあればアプリで、なければウェブサイトで開きます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认播放器。没有自己歌单的拍摄，按钮就打开它。装了应用就打开应用，没装就打开网站。"
          }
        }
      }
    },
    "set.musicNoteOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без плеера по умолчанию. Кнопка появится только у съёмки со своим плейлистом."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No default player. The button appears only on a shoot that has its own playlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
