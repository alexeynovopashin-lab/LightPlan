    "wc.moonWashM" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск освещён на {pct}% и стоит над горизонтом почти всю тёмную часть ночи. Путь не проявится — ищите ночь ближе к новолунию."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disc is {pct}% lit and stays above the horizon through most of the dark hours. The Way will not show — look for a night closer to the new moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco está iluminado al {pct}% y se mantiene sobre el horizonte casi toda la parte oscura de la noche. La Vía no se va a ver — busca una noche cerca de la luna nueva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月は{pct}%輝いており、夜の暗い時間のほとんど地平線上にあります。天の川は写らないので、新月に近い夜を探してください。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月盘照亮{pct}%，在大部分黑暗时段位于地平线以上。银河不会显现——寻找接近新月的夜晚。"
          }
        }
      }
    },
