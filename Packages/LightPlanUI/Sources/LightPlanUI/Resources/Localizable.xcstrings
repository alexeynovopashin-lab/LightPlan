    "tour.end.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знакомство живёт в настройках и повторяется в любой момент — целиком или с нужного шага."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tour lives in settings and repeats whenever you like — all of it or from the step you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La introducción vive en los ajustes y se repite cuando quieras — entera o desde el paso que necesites."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーは設定にあり、いつでも最初から、または必要なステップから繰り返せます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "介绍内容保存在设置中，可随时重新开始 — 从头或从指定步骤。"
          }
        }
      }
    },
