    "set.plNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список общий: заводится один раз, а съёмка выбирает из него барабаном. Имя своё — по нему вы узнаете плейлист в карточке. Оставите пустым — подставим сервис."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One shared list: set it up once, and a shoot picks from it with the wheel. The name is yours — it is what you will see on the card. Leave it empty and we put the service there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista es común: se crea una vez y la sesión elige de ella con el tambor. El nombre es suyo: por él reconocerá la lista en la ficha. Si lo deja vacío, ponemos el servicio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共通のリストです。一度設定すれば、撮影ではホイールで選べます。名前は自由で、カードに表示されます。空欄ならサービス名が入ります。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表是公用的：建一次，拍摄用转盘从中挑选。名称由你自己起——卡片上靠它认出歌单。留空就填服务名。"
          }
        }
      }
    },
