    "practice.note.eu" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Договор, счёт с НДС, оплата, протокол приёмки. Цепочка есть и у частной съёмки."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contract, VAT invoice, payment, acceptance protocol. The chain also appears for private shoots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrato, factura con IVA, pago, protocolo de recepción. La cadena también aparece en sesiones particulares."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "契約書、VAT請求書、支払い、検収書。個人の撮影にも流れが表示されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合同、含增值税发票、付款、验收协议。私人拍摄也有交易链。"
          }
        }
      }
    },
    "practice.note.ru" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Договор, счёт, оплата, акт выполненных работ. С частным клиентом договариваются на словах — цепочка сделки только у заказов."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contract, invoice, payment, acceptance act. Private clients are handled on a handshake — the deal chain appears only for orders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrato, factura, pago, acta de conformidad. Con el cliente particular se acuerda de palabra — la cadena del acuerdo aparece solo en los encargos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "契約書、請求書、支払い、検収書。個人の依頼主とは口約束で、取引の流れは法人の注文にのみ表示されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合同、发票、付款、验收单。私人客户口头约定——交易链仅出现在订单中。"
          }
        }
      }
    },
    "practice.note.uk" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Договор, возвратный депозит, остаток, передача материала. Акта нет. Цепочка есть и у частной съёмки."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contract, refundable deposit, balance, delivery. No acceptance act. The chain also appears for private shoots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrato, depósito reembolsable, saldo, entrega del material. Sin acta. La cadena también aparece en sesiones particulares."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "契約書、返金可能な前金、残金、納品。検収書はなし。個人の撮影にも流れが表示されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合同、可退还押金、余额、交付。无验收单。私人拍摄也有交易链。"
          }
        }
      }
    },
    "practice.note.us" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Договор, невозвратный ретейнер, остаток, релиз модели. Акта нет. Цепочка есть и у частной съёмки: договор с парой — норма."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contract, non-refundable retainer, balance, model release. No acceptance act. The chain also appears for private shoots: a contract with the couple is the norm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrato, retainer no reembolsable, saldo, cesión de imagen. Sin acta. La cadena también aparece en sesiones particulares: el contrato con la pareja es lo normal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "契約書、返金不可のリテイナー、残金、モデルリリース。検収書はなし。個人の撮影にも流れが表示されます。カップルとの契約書が一般的です。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
