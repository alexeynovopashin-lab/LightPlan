    "tour.dome.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дуга — путь солнца от восхода до заката, диск — где оно сейчас. Штрих вниз показывает высоту и длину тени."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The arc is the sun's path from rise to set, the disc is where it is now. The dash below gives its height and the shadow length."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arco es el camino del sol de la salida a la puesta, el disco es dónde está ahora. La marca hacia abajo muestra su altura y la longitud de la sombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弧は日の出から日の入りまでの太陽の道筋、円盤は今の位置です。下の線は高度と影の長さを示します。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弧线为太阳从升起到落下的路径，圆盘为当前位置。下方刻度显示高度和影长。"
          }
        }
      }
    },
    "tour.dome.t" : {
