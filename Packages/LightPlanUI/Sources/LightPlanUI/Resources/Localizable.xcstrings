    "tour.bin.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённая съёмка не пропадает: она лежит в корзине и возвращается на своё место одной кнопкой. Строка появляется здесь, как только в корзине что-то есть."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A deleted shoot does not vanish: it waits in the bin and comes back to its place with one button. The row appears here as soon as the bin has anything in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión eliminada no desaparece: queda en la papelera y vuelve a su lugar con un botón. La fila aparece aquí en cuanto la papelera tiene algo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した撮影は消えません。ゴミ箱で待ち、ボタンひとつで元の場所に戻ります。ゴミ箱に何か入るとここに行が表示されます。"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的拍摄不会消失：它保留在回收站中，一键即可恢复。一旦回收站有内容，此条目就会出现。"
          }
        }
      }
    },
    "tour.bin.t" : {
